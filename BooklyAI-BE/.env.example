# Environment — copy to .env and fill in values. Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booklyai?schema=public"

# JWT signing secret (use a long random string in production, min 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-32chars"

# Cookie / token lifetime in days
JWT_EXPIRES_IN_DAYS=7

# Cookie name for the HttpOnly auth token
AUTH_COOKIE_NAME="booklyai_token"

# Frontend origin for CORS
FRONTEND_URL="http://localhost:3000"

# Server
PORT=4000
NODE_ENV="development"

# Mistral (used from Phase 5)
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
