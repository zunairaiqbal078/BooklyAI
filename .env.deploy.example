# Copy to `.env` on the EC2 host (never commit real secrets).
# Then: docker compose up -d --build

# Public URL users open in the browser (no trailing slash).
# Use your EC2 public IP for a quick test, or your domain once DNS is set.
# Examples:
#   APP_URL=http://3.XX.XX.XX
#   APP_URL=https://bookly.example.com
APP_URL=http://YOUR_EC2_PUBLIC_IP

HTTP_PORT=80

# Postgres (Docker internal — do not expose 5432 publicly)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=booklyai

# Backend auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7
AUTH_COOKIE_NAME=booklyai_token

# Optional AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Maps (baked into the Next.js build)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
